# Copy to backend/.env and fill in. Never commit the real .env file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tudun_wada_emergency
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma separated, no trailing slash. Add your Vercel URL after deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional: allow Vercel preview URLs, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
# Used only by seed.py. Use unique, strong passwords and keep this file private.
ADMIN_EMAIL=admin@tudunwada.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
RESPONDER_EMAIL=responder@tudunwada.local
RESPONDER_PASSWORD=replace-with-a-strong-responder-password
